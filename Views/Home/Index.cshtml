@{
    ViewData["Title"] = "Inicio";
    List<string> materiasDestacadas = ViewBag.materiasDestacadas ?? new List<string>();
    List<Profesor> profesoresDestacados = ViewBag.profesoresDestacados ?? new List<Profesor>();
}

<!-- ================= PORTADA / BUSCADOR ================= -->
<section class="portada">
    <span class="figura coral" aria-hidden="true"></span>
    <span class="figura celeste" aria-hidden="true"></span>

    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-12 lg:col-6 text-center lg:text-start">
                <span class="pildora animarEntrada"><i class="bi bi-mortarboard" aria-hidden="true"></i> Tutorías entre colegios</span>

                <h1 class="animarEntrada" style="--retraso: .1s">
                    Encontrá al profesor ideal <mark>para tu colegio</mark>
                </h1>

                <p class="animarEntrada" style="--retraso: .2s">
                    MiProfesor conecta alumnos con docentes que conocen su institución y su programa.
                    Buscá por materia o colegio, coordiná por chat y tomá tus clases presenciales o virtuales.
                </p>

                @* El formulario envía a Home/Catalogo?busqueda= *@
                <form class="buscador animarEntrada" id="formularioBuscador" style="--retraso: .3s"
                      method="get" asp-controller="Home" asp-action="Catalogo" onsubmit="return validarBusqueda()" novalidate>
                    <label for="campoBusqueda" class="visually-hidden">Buscar materia, profesor o colegio</label>
                    <input type="text" id="campoBusqueda" name="busqueda" placeholder="Materia, profesor o colegio..." autocomplete="off" />
                    <button type="submit" class="boton principal">
                        <span class="d-none sm:d-inline">Buscar</span>
                        <i class="bi bi-search sm:d-none" aria-hidden="true"></i>
                    </button>
                </form>
                <p class="mensajeError" id="mensajeErrorBusqueda" role="alert"></p>

                <div class="acciones animarEntrada" style="--retraso: .4s">
                    <a class="boton secundario" asp-controller="Home" asp-action="Registrarse" asp-route-rol="alumno">Soy alumno</a>
                    <a class="boton contorno" asp-controller="Home" asp-action="Registrarse" asp-route-rol="profesor">Quiero enseñar</a>
                </div>
            </div>

            @* Composición ilustrativa: tarjetas de ejemplo, solo decorativas *@
            <div class="col-12 md:col-10 lg:col-6 mx-auto" aria-hidden="true">
                <div class="composicion">
                    <div class="card">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar theme-primary">SM</span>
                            <div>
                                <strong>Prof. Sofía Martínez</strong>
                                <p>Matemática · Belgrano Day School</p>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge badge-subtle theme-accent"><i class="bi bi-calculator"></i> Álgebra</span>
                            <span class="badge badge-subtle theme-accent"><i class="bi bi-graph-up"></i> Estadística</span>
                            <span class="badge badge-subtle theme-warning"><i class="bi bi-star-fill"></i> 4.9</span>
                        </div>
                    </div>

                    <div class="card">
                        <span class="badge badge-subtle theme-success">Confirmada</span>
                        <strong>Física I: Dinámica</strong>
                        <p><i class="bi bi-calendar-event"></i> Viernes, 18:30 hs · <i class="bi bi-laptop"></i> Virtual</p>
                    </div>

                    <div class="card">
                        <p class="burbuja">¿Tenés el programa del colegio a mano?</p>
                        <p class="burbuja propia">¡Sí! Te lo adjunto <i class="bi bi-paperclip"></i></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= CINTA DE MATERIAS ================= -->
<section class="cinta" aria-label="Materias disponibles">
    <div>
        @* Se repite dos veces para lograr un desplazamiento infinito sin cortes *@
        @for (int repeticion = 0; repeticion < 2; repeticion++)
        {
            <ul aria-hidden="@(repeticion == 1 ? "true" : "false")">
                @foreach (string materia in materiasDestacadas)
                {
                    <li>@materia</li>
                }
            </ul>
        }
    </div>
</section>

<!-- ================= CÓMO FUNCIONA ================= -->
<section class="pasos" id="seccionComoFunciona">
    <div class="container">
        <div class="encabezadoSeccion">
            <span class="pildora">Paso a paso</span>
            <h2>¿Cómo funciona MiProfesor?</h2>
            <p>En tres pasos pasás de tener una duda a tener una clase agendada.</p>
        </div>

        <ol class="row g-3 lg:g-4">
            <li class="col-12 md:col-4">
                <div class="card">
                    <span class="numero">1</span>
                    <h3>Creá tu cuenta</h3>
                    <p>Registrate como alumno o como profesor y vinculá tu colegio para recibir recomendaciones personalizadas.</p>
                </div>
            </li>
            <li class="col-12 md:col-4">
                <div class="card">
                    <span class="numero">2</span>
                    <h3>Buscá y filtrá</h3>
                    <p>Explorá el catálogo por materia, nivel o institución y encontrá docentes que ya conocen tu programa.</p>
                </div>
            </li>
            <li class="col-12 md:col-4">
                <div class="card">
                    <span class="numero">3</span>
                    <h3>Coordiná y aprendé</h3>
                    <p>Reservá la clase, hablá con el profesor por chat directo y gestioná todo desde tu Panel de Control.</p>
                </div>
            </li>
        </ol>
    </div>
</section>

<!-- ================= PERFILES: ALUMNO / PROFESOR ================= -->
<section class="perfiles">
    <div class="container">
        <div class="encabezadoSeccion">
            <span class="pildora">Para todos</span>
            <h2>Un lugar para aprender y para enseñar</h2>
        </div>

        <div class="row g-3 lg:g-4">
            <div class="col-12 lg:col-6">
                <div class="card coral">
                    <span class="icono"><i class="bi bi-backpack" aria-hidden="true"></i></span>
                    <h3>¿Buscás apoyo para el colegio?</h3>
                    <p>Encontrá la ayuda que necesitás, con profesores que entienden cómo se trabaja en tu colegio.</p>
                    <ul>
                        <li>Profesores filtrados por tu institución</li>
                        <li>Clases presenciales o virtuales</li>
                        <li>Chat directo para coordinar horarios</li>
                        <li>Historial de todas tus clases</li>
                    </ul>
                    <a class="boton principal" asp-controller="Home" asp-action="Registrarse" asp-route-rol="alumno">Registrarme como alumno</a>
                </div>
            </div>
            <div class="col-12 lg:col-6">
                <div class="card oscura">
                    <span class="icono"><i class="bi bi-person-video3" aria-hidden="true"></i></span>
                    <h3>¿Sos profesor particular?</h3>
                    <p>Compartí tu conocimiento y llegá a los alumnos de los colegios donde ya enseñás.</p>
                    <ul>
                        <li>Cargá tus materias y credenciales</li>
                        <li>Definí tus colegios y horarios</li>
                        <li>Administrá clases, cancelaciones y reubicaciones</li>
                        <li>Recibí reseñas de tus alumnos</li>
                    </ul>
                    <a class="boton secundario" asp-controller="Home" asp-action="Registrarse" asp-route-rol="profesor">Registrarme como profesor</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= FUNCIONALIDADES ================= -->
<section class="funciones">
    <div class="container">
        <div class="encabezadoSeccion">
            <span class="pildora">Funcionalidades</span>
            <h2>Todo lo que necesitás, en un solo lugar</h2>
        </div>

        <div class="row row-cols-1 sm:row-cols-2 lg:row-cols-3 g-3 lg:g-4">
            <div class="col">
                <div class="card">
                    <span class="icono"><i class="bi bi-building" aria-hidden="true"></i></span>
                    <h3>Filtro por colegio</h3>
                    <p>Encontrá docentes vinculados a tu institución con un solo clic.</p>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <span class="icono celeste"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                    <h3>Chat directo</h3>
                    <p>Hablá con tu profesor antes y después de cada clase.</p>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <span class="icono oscuro"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                    <h3>Cancelar o reubicar</h3>
                    <p>Si surge un imprevisto, cancelá o acordá una nueva fecha sin complicaciones.</p>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <span class="icono celeste"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                    <h3>Presencial o virtual</h3>
                    <p>Elegí tomar la clase en tu colegio o conectarte desde donde estés.</p>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <span class="icono oscuro"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                    <h3>Historial de clases</h3>
                    <p>Consultá tus clases pasadas y repetí con el profesor que más te sirvió.</p>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <span class="icono"><i class="bi bi-star-fill" aria-hidden="true"></i></span>
                    <h3>Reseñas reales</h3>
                    <p>Leé la experiencia de otros alumnos antes de reservar.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= PROFESORES DESTACADOS ================= -->
<section class="destacados">
    <div class="container">
        <div class="encabezadoSeccion">
            <span class="pildora">Catálogo</span>
            <h2>Profesores destacados</h2>
            <p>Docentes verificados y bien valorados por los alumnos de tu comunidad.</p>
        </div>

        <div class="row row-cols-1 md:row-cols-2 lg:row-cols-3 g-3 lg:g-4">
            @foreach (var profesor in profesoresDestacados)
            {
                <div class="col">
                    <partial name="_tarjetaProfesor" model="profesor" />
                </div>
            }
        </div>

        <div class="colegios">
            <span>Explorá por colegio:</span>
            <a class="badge badge-outline theme-inverse" asp-controller="Home" asp-action="Catalogo" asp-route-colegio="Belgrano Day School"><i class="bi bi-building"></i> Belgrano Day School</a>
            <a class="badge badge-outline theme-inverse" asp-controller="Home" asp-action="Catalogo" asp-route-colegio="Colegio San Martín"><i class="bi bi-building"></i> Colegio San Martín</a>
            <a class="badge badge-outline theme-inverse" asp-controller="Home" asp-action="Catalogo" asp-route-colegio="Nacional Buenos Aires"><i class="bi bi-building"></i> Nacional Buenos Aires</a>
            <a class="boton oscuro chico" asp-controller="Home" asp-action="Catalogo">Ver todos <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
    </div>
</section>

<!-- ================= OPINIONES ================= -->
<section class="opiniones">
    <div class="container">
        <div class="encabezadoSeccion">
            <span class="pildora">Reseñas</span>
            <h2>Lo que dicen los alumnos</h2>
        </div>

        @* TODO BD: reemplazar estos ejemplos por BD.obtenerReseñasDestacadas() *@
        <div id="carruselOpiniones" class="carousel slide" aria-label="Opiniones de alumnos">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <figure class="card">
                        <p class="estrellas" aria-label="5 de 5 estrellas">★★★★★</p>
                        <blockquote>“Con Sofía por fin entendí funciones. Ya conocía el programa de mi colegio y fuimos directo a lo que me tomaban.”</blockquote>
                        <figcaption><span class="avatar theme-accent">AL</span><div><strong>Ana L.</strong><span>Alumna · Belgrano Day School</span></div></figcaption>
                    </figure>
                </div>
                <div class="carousel-item">
                    <figure class="card">
                        <p class="estrellas" aria-label="5 de 5 estrellas">★★★★★</p>
                        <blockquote>“Cancelé una clase a último momento y reprogramamos por el chat en minutos. Cero complicaciones.”</blockquote>
                        <figcaption><span class="avatar theme-primary">JP</span><div><strong>Juan P.</strong><span>Alumno · Colegio San Martín</span></div></figcaption>
                    </figure>
                </div>
                <div class="carousel-item">
                    <figure class="card">
                        <p class="estrellas" aria-label="5 de 5 estrellas">★★★★★</p>
                        <blockquote>“Como profesor, MiProfesor me acercó alumnos de los colegios donde ya doy clases. Es lo que necesitaba.”</blockquote>
                        <figcaption><span class="avatar theme-inverse">MA</span><div><strong>Martín A.</strong><span>Profesor · Nacional Buenos Aires</span></div></figcaption>
                    </figure>
                </div>
                <div class="carousel-item">
                    <figure class="card">
                        <p class="estrellas" aria-label="4 de 5 estrellas">★★★★☆</p>
                        <blockquote>“Mi hijo encontró profesora de Inglés cerca de casa y a un precio que se ve desde el principio.”</blockquote>
                        <figcaption><span class="avatar theme-warning">CG</span><div><strong>Carolina G.</strong><span>Mamá de alumno · Belgrano Day School</span></div></figcaption>
                    </figure>
                </div>
            </div>

            <div class="controles">
                <button class="btn-icon" type="button" data-bs-target="#carruselOpiniones" data-bs-slide="prev">
                    <span class="carousel-icon-prev" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="btn-icon" type="button" data-bs-target="#carruselOpiniones" data-bs-slide="next">
                    <span class="carousel-icon-next" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- ================= PREGUNTAS FRECUENTES ================= -->
<section class="preguntas">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 lg:col-9 xl:col-8">
                <div class="encabezadoSeccion">
                    <span class="pildora">Ayuda</span>
                    <h2>Preguntas frecuentes</h2>
                    <p>Las dudas más habituales, resueltas.</p>
                </div>

                <partial name="_preguntasFrecuentes" />

                <p class="ayudaExtra">
                    ¿No encontraste lo que buscabas? <a asp-controller="Home" asp-action="Soporte">Ir al centro de soporte <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ================= LLAMADO FINAL ================= -->
<section class="llamadoFinal">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-12 lg:col-8 text-center lg:text-start">
                <h2>¿Listo para tu próxima clase?</h2>
                <p>Sumate a MiProfesor y empezá a aprender con docentes de tu propia comunidad educativa.</p>
            </div>
            <div class="col-12 lg:col-4 acciones">
                <a class="boton secundario" asp-controller="Home" asp-action="Registrarse">Crear cuenta gratis</a>
                <a class="boton claro" asp-controller="Home" asp-action="Catalogo">Ver catálogo</a>
            </div>
        </div>
    </div>
</section>
