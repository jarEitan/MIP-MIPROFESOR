@{
    ViewData["Title"] = "Iniciar sesión";
}

<!-- ================= LOGIN ================= -->
<section class="acceso">
    <div class="container">
        <div class="row align-items-center g-4 lg:g-5">
            <div class="col-12 lg:col-6 xl:col-5 lg:order-2">
                <div class="card estatica">
                    <h1>¡Hola de nuevo!</h1>
                    <p>Ingresá para ver tus clases, mensajes y profesores favoritos.</p>

                    @* TODO BD: enviar con method="post" a una acción que llame a BD.iniciarSesion(...) *@
                    <form id="formularioIngreso" onsubmit="return validarIngreso()" novalidate>
                        <div class="form-field">
                            <label for="ingresoCorreo">Correo electrónico</label>
                            <input class="form-control" type="email" id="ingresoCorreo" name="correo" autocomplete="email" />
                        </div>

                        <div class="form-field">
                            <label for="ingresoContrasena">Contraseña</label>
                            <input class="form-control" type="password" id="ingresoContrasena" name="contrasena" autocomplete="current-password" />
                        </div>

                        <p class="mensajeError" id="mensajeIngreso" role="alert"></p>

                        <button class="boton principal" type="submit">Iniciar sesión</button>
                    </form>

                    <p class="alternativa">¿Todavía no tenés cuenta? <a asp-controller="Home" asp-action="Registrarse">Creá una gratis</a></p>
                </div>
            </div>

            <div class="col-12 lg:col-6 xl:col-7 lg:order-1">
                <div class="ilustracion">
                    <img src="~/img/logoChico.png" alt="" width="120" height="120" />
                    <h2>El conocimiento nos conecta</h2>
                    <ul>
                        <li>Seguí tus clases activas</li>
                        <li>Reubicá o cancelá sin vueltas</li>
                        <li>Hablá con tus profesores</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
