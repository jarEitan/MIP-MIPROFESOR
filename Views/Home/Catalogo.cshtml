@{
    ViewData["Title"] = "Catálogo";
    List<Profesor> profesores = ViewBag.profesores ?? new List<Profesor>();
    List<string> materias = ViewBag.materias ?? new List<string>();
    List<string> colegios = ViewBag.colegios ?? new List<string>();
    List<string> niveles = ViewBag.niveles ?? new List<string>();
    List<string> modalidades = ViewBag.modalidades ?? new List<string>();
    string busqueda = ViewBag.busqueda ?? "";
    string materiaElegida = ViewBag.materia ?? "";
    string colegioElegido = ViewBag.colegio ?? "";
    string modalidadElegida = ViewBag.modalidad ?? "";
    List<string> nivelesElegidos = ViewBag.nivelesElegidos ?? new List<string>();
    string? errorCatalogo = ViewBag.errorCatalogo;
}

<!-- ================= CABECERA ================= -->
<section class="cabecera">
    <div class="container">
        <span class="pildora"><i class="bi bi-search" aria-hidden="true"></i> Catálogo</span>
        <h1>Encontrá a tu profesor</h1>
        <p>Filtrá por materia, colegio, modalidad y nivel. Todos los precios son por hora y los ves antes de contactar.</p>
    </div>
</section>

<!-- ================= FILTROS + RESULTADOS ================= -->
<section class="catalogo">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 lg:col-4 xl:col-3">
                <aside class="filtros">
                    <button class="boton contorno" type="button" data-bs-toggle="drawer" data-bs-target="#panelFiltros" aria-controls="panelFiltros">
                        <i class="bi bi-funnel" aria-hidden="true"></i> Filtros
                    </button>

                    @* En pantallas < lg los filtros son un drawer lateral; desde lg quedan en línea (lg:drawer) *@
                    <dialog class="lg:drawer drawer-start" tabindex="-1" id="panelFiltros" aria-labelledby="tituloFiltros">
                        <div class="drawer-header">
                            <span class="drawer-title" id="tituloFiltros">Filtros</span>
                            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Cerrar"></button>
                        </div>

                        <div class="drawer-body">
                            <form id="formularioFiltros" method="get" asp-controller="Home" asp-action="Catalogo">
                                <div class="form-field">
                                    <label for="filtroTexto">Buscar</label>
                                    <input class="form-control" type="search" id="filtroTexto" name="busqueda" value="@busqueda" placeholder="Nombre, materia o tema..." autocomplete="off" />
                                </div>

                                <div class="form-field">
                                    <label for="filtroMateria">Materia</label>
                                    <select class="form-control" id="filtroMateria" name="materia" data-buscable data-placeholder="Buscá una materia">
                                        <option value="">Todas las materias</option>
                                        @foreach (string materia in materias)
                                        {
                                            <option value="@materia" selected="@(materia == materiaElegida ? "selected" : null)">@materia</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-field">
                                    <label for="filtroColegio">Colegio</label>
                                    <select class="form-control" id="filtroColegio" name="colegio" data-buscable data-placeholder="Buscá un colegio">
                                        <option value="">Todos los colegios</option>
                                        @foreach (string colegio in colegios)
                                        {
                                            <option value="@colegio" selected="@(colegio == colegioElegido ? "selected" : null)">@colegio</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-field">
                                    <label for="filtroModalidad">Modalidad</label>
                                    <select class="form-control" id="filtroModalidad" name="modalidad" data-buscable data-placeholder="Presencial o virtual">
                                        <option value="">Todas las modalidades</option>
                                        @foreach (string modalidad in modalidades)
                                        {
                                            <option value="@modalidad" selected="@(modalidad == modalidadElegida ? "selected" : null)">@modalidad</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-field">
                                    <label for="filtroNivel">Nivel escolar</label>
                                    <select class="form-control" id="filtroNivel" name="nivel" data-buscable data-placeholder="Todos los niveles" multiple>
                                        @foreach (string nivel in niveles)
                                        {
                                            <option value="@nivel" selected="@(nivelesElegidos.Contains(nivel) ? "selected" : null)">@nivel</option>
                                        }
                                    </select>
                                </div>

                                <a class="boton contorno chico" id="botonLimpiarFiltros" asp-controller="Home" asp-action="Catalogo">Limpiar filtros</a>
                            </form>
                        </div>
                    </dialog>
                </aside>
            </div>

            <div class="col-12 lg:col-8 xl:col-9">
                <p class="cantidad" id="cantidadResultados" aria-live="polite">@(profesores.Count == 1 ? "1 profesor" : profesores.Count + " profesores")</p>

                <div class="row row-cols-1 md:row-cols-2 xl:row-cols-3 g-3 lg:g-4" id="listaProfesores">
                    @foreach (var profesor in profesores)
                    {
                        <div class="col">
                            <partial name="_tarjetaProfesor" model="profesor" />
                        </div>
                    }
                </div>

                @if (errorCatalogo != null)
                {
                    <div class="card estatica sinResultados" id="sinResultados">
                        <span class="icono"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                        <h3>Algo salió mal</h3>
                        <p>@errorCatalogo</p>
                    </div>
                }
                else if (profesores.Count == 0)
                {
                    <div class="card estatica sinResultados" id="sinResultados">
                        <span class="icono"><i class="bi bi-emoji-neutral" aria-hidden="true"></i></span>
                        <h3>No encontramos profesores con esos filtros</h3>
                        <p>Probá quitando algún filtro o buscando otra materia.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
