@* Panel de Control. Los contadores y las notificaciones vienen de la BD (HomeController.PanelControl). Las clases son un
   calendario + agenda del día que dibuja calendario.js con fetch a /Clases/Calendario; las acciones (aceptar, rechazar,
   cambiar horario, cancelar) se envían con fetch a ClasesController. La agenda del profesor es miAgenda.js, el chat
   se pide y se envía con fetch a MensajesController (chat.js) y el historial es historial.js. *@
@{
    ViewData["Title"] = "Panel de Control";
    ContadoresClases contadores = ViewBag.contadores ?? new ContadoresClases();
    List<NotificacionUsuario> notificaciones = ViewBag.notificaciones ?? new List<NotificacionUsuario>();
    bool errorBD = ViewBag.errorBD ?? false;
    bool sinAgenda = ViewBag.sinAgenda ?? false;
    // Acciones: cuentan en la insignia. Noticias: solo para enterarse (3 días)
    List<NotificacionUsuario> acciones = notificaciones.Where(notificacion => notificacion.grupo == "accion").ToList();
    List<NotificacionUsuario> noticias = notificaciones.Where(notificacion => notificacion.grupo == "noticia").ToList();
    int mensajesSinLeer = acciones.Where(notificacion => notificacion.tipo == "mensajesSinLeer").Sum(notificacion => notificacion.cantidad);
    string nombreUsuario = ((Context.Session.GetString("nombre") ?? "") + " " + (Context.Session.GetString("apellido") ?? "")).Trim();
    bool esProfesor = Context.Session.GetString("tipoUsuario") == "profesor";
    string rolUsuario = esProfesor ? "Profesor" : "Alumno";
}

@functions {
    // "lunes 19 de octubre" / "hace 5 min": formato argentino (la cultura es-AR se fija en Program.cs)
    static string tiempoRelativo(DateTime fecha)
    {
        TimeSpan pasado = DateTime.Now - fecha;
        if (pasado.TotalMinutes < 1) return "recién";
        if (pasado.TotalMinutes < 60) return "hace " + (int)pasado.TotalMinutes + " min";
        if (pasado.TotalHours < 24) return "hace " + (int)pasado.TotalHours + " h";
        if (pasado.TotalDays < 7) return "hace " + (int)pasado.TotalDays + (pasado.TotalDays < 2 ? " día" : " días");
        return fecha.ToString("dd/MM/yyyy");
    }

    static string iconoDeNotificacion(string tipo)
    {
        switch (tipo)
        {
            case "solicitudAmistad": return "bi-person-plus";
            case "mensajesSinLeer": return "bi-chat-dots";
            case "pedidoPorResponder": return "bi-calendar-plus";
            case "propuestaPorResponder": return "bi-arrow-repeat";
            case "pideCambioPorResponder": return "bi-arrow-left-right";
            case "pideCancelarPorResponder": return "bi-x-octagon";
            case "claseConfirmada": return "bi-calendar-check";
            case "claseCancelada": return "bi-calendar-x";
            case "claseTerminada": return "bi-star";
            case "claseNoConcretada": return "bi-calendar-minus";
            default: return "bi-calendar-x";
        }
    }
}

<!-- ================= SALUDO ================= -->
@* Pegatinas del encabezado (rol y contadores). Los contadores los reescribe refrescarPanel (clases.js) *@
<section class="bienvenida">
    <div class="container">
        <div class="saludo">
            <partial name="_avatarUsuario" model='"avatar-xl"' />
            <div class="textoSaludo">
                <span class="pegatina celeste" style="--giro: 3deg">@rolUsuario</span>
                <h1>¡Hola, @nombreUsuario!</h1>
                <p>Gestioná tus clases y tus mensajes.</p>
            </div>
            <div class="plancha">
                <div class="pegatina contador" style="--giro: -2deg">
                    <strong id="contadorClasesActivas">@(contadores.pendientes + contadores.proximas)</strong>
                    <span>Clases activas</span>
                </div>
                <div class="pegatina oscura contador" style="--giro: 2.5deg">
                    <strong id="contadorClasesCompletadas">@contadores.completadas</strong>
                    <span>Clases completadas</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* Token para los fetch POST de las clases y del chat (clases.js y chat.js lo mandan en el encabezado) *@
@Html.AntiForgeryToken()

@* Aviso solo para profesores que todavía no configuraron su agenda (miAgenda.js lo oculta al guardarla) *@
@if (sinAgenda)
{
    <section class="avisoAgenda" id="avisoSinAgenda">
        <div class="container">
            <div class="card">
                <span class="icono"><i class="bi bi-calendar-week" aria-hidden="true"></i></span>
                <p><strong>Configurá tu agenda.</strong> Los alumnos pueden pedirte clases de 8 a 22 cualquier día. Elegí tus días y horarios para recibir solo pedidos que te sirvan.</p>
                <a class="boton principal chico" href="#panelTabs" data-abrir-tab="tabAgenda">Configurar mi agenda</a>
            </div>
        </div>
    </section>
}

<!-- ================= NOTIFICACIONES ================= -->
@* Dos columnas dentro de #notificaciones: refrescarPanel (clases.js) reemplaza su contenido entero *@
<section class="notificaciones" id="notificaciones" aria-labelledby="tituloNotificaciones">
    <div class="container">
        <div class="columnasNotificaciones">
            <div class="card pendientes">
                <h2 id="tituloNotificaciones">
                    <i class="bi bi-bell" aria-hidden="true"></i> Requiere tu acción
                    <span class="badge" id="cantidadNotificacionesPanel" hidden="@(acciones.Count == 0)">@acciones.Count</span>
                </h2>

                @if (errorBD)
                {
                    <p class="sinNotificaciones">No pudimos cargar tus notificaciones. Probá de nuevo en unos minutos.</p>
                }
                else if (acciones.Count == 0)
                {
                    <p class="sinNotificaciones">No tenés nada pendiente. Acá vas a ver las solicitudes de amistad, los mensajes sin leer y las clases que esperan tu respuesta.</p>
                }
                else
                {
                    @* Cada notificación de acción es algo a medio resolver: desaparece sola cuando se resuelve (al abrir el chat, responder la clase, etc.) *@
                    <ul class="listaNotificaciones" id="listaAcciones">
                        @foreach (var notificacion in acciones)
                        {
                            bool esChat = notificacion.tipo == "mensajesSinLeer";
                            bool esAmistad = notificacion.tipo == "solicitudAmistad";
                            string urlDestino = notificacion.destino == "perfil"
                                ? Url.Action("Perfil", "Home", new { id = notificacion.idOtroUsuario })!
                                : esChat
                                    ? Url.Action("PanelControl", "Home", new { tab = "chat", chat = notificacion.idOtroUsuario })!
                                    : Url.Action("PanelControl", "Home", new { tab = "clases", clase = notificacion.idClase })!;
                            <li class="notificacion" data-tipo="@notificacion.tipo" data-id-otro="@notificacion.idOtroUsuario" data-nombre="@notificacion.nombreOtro">
                                <span class="icono @(esChat ? "celeste" : "")"><i class="bi @iconoDeNotificacion(notificacion.tipo)" aria-hidden="true"></i></span>
                                <div class="textoNotificacion">
                                    <h3>
                                        @notificacion.titulo
                                        @if (esChat)
                                        {
                                            <span class="badge theme-primary">@(notificacion.cantidad == 1 ? "1 sin leer" : $"{notificacion.cantidad} sin leer")</span>
                                        }
                                    </h3>
                                    <p>
                                        @notificacion.mensaje
                                        @if (esAmistad)
                                        {
                                            <a href="@urlDestino">Ver perfil</a>
                                        }
                                        @if (notificacion.fecha != null)
                                        {
                                            <small>· @tiempoRelativo(notificacion.fecha.Value)</small>
                                        }
                                    </p>
                                </div>
                                @if (esAmistad)
                                {
                                    @* La solicitud se responde acá mismo (clases.js → /Notificaciones/ResponderAmistad) *@
                                    <div class="accionesNotificacion">
                                        <button class="boton contorno chico" type="button" data-responder-amistad="rechazar" aria-label="Rechazar la solicitud de @notificacion.nombreOtro @notificacion.apellidoOtro">Rechazar</button>
                                        <button class="boton principal chico" type="button" data-responder-amistad="aceptar" aria-label="Aceptar la solicitud de @notificacion.nombreOtro @notificacion.apellidoOtro"><i class="bi bi-check-lg" aria-hidden="true"></i> Aceptar</button>
                                    </div>
                                }
                                else
                                {
                                    <a class="boton principal chico" href="@urlDestino">@notificacion.textoBoton</a>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            @* Novedades: noticias de los últimos 3 días. No cuentan en la insignia ni esperan respuesta. Sin noticias no se muestra la columna *@
            @if (!errorBD && noticias.Count > 0)
            {
                <div class="card novedades">
                    <h2 id="tituloNovedades"><i class="bi bi-megaphone" aria-hidden="true"></i> Novedades</h2>
                    <ul class="listaNotificaciones" aria-labelledby="tituloNovedades">
                        @foreach (var noticia in noticias)
                        {
                            string urlNoticia = Url.Action("PanelControl", "Home", new { tab = "clases", clase = noticia.idClase })!;
                            <li class="notificacion noticia" data-tipo="@noticia.tipo">
                                <span class="icono celeste"><i class="bi @iconoDeNotificacion(noticia.tipo)" aria-hidden="true"></i></span>
                                <div class="textoNotificacion">
                                    <h3>@noticia.titulo</h3>
                                    <p>
                                        @noticia.mensaje
                                        @if (noticia.fecha != null)
                                        {
                                            <small>· @tiempoRelativo(noticia.fecha.Value)</small>
                                        }
                                    </p>
                                    @if (noticia.destino == "resena")
                                    {
                                        @* Abre el diálogo Dar reseña del layout (site.js: inicializarResenas) *@
                                        <button class="boton principal chico" type="button" data-dar-resena data-id-usuario="@noticia.idOtroUsuario" data-nombre-usuario="@noticia.nombreOtro @noticia.apellidoOtro"><i class="bi bi-star" aria-hidden="true"></i> @noticia.textoBoton</button>
                                    }
                                    else
                                    {
                                        <a class="boton contorno chico" href="@urlNoticia">@noticia.textoBoton</a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<!-- ================= PANEL CON PESTAÑAS ================= -->
<section class="panel" id="panelTabs">
    <div class="container">
        <nav>
            <div class="nav nav-pills" role="tablist">
                <button class="nav-link active" id="botonTabClases" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabClases" aria-controls="tabClases" aria-selected="true"><i class="bi bi-calendar-check" aria-hidden="true"></i> Mis clases</button>
                @if (esProfesor)
                {
                    <button class="nav-link" id="botonTabAgenda" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabAgenda" aria-controls="tabAgenda" aria-selected="false"><i class="bi bi-calendar-week" aria-hidden="true"></i> Mi agenda</button>
                }
                <button class="nav-link" id="botonTabChat" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabChat" aria-controls="tabChat" aria-selected="false"><i class="bi bi-chat-dots" aria-hidden="true"></i> Chat directo <span class="badge theme-primary" id="insigniaChat" hidden="@(mensajesSinLeer == 0)">@mensajesSinLeer</span></button>
                <button class="nav-link" id="botonTabHistorial" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabHistorial" aria-controls="tabHistorial" aria-selected="false"><i class="bi bi-clock-history" aria-hidden="true"></i> Historial</button>
            </div>
        </nav>

        <div class="tab-content">
            <!-- Mis clases: calendario del mes + agenda del día (calendario.js, con fetch a /Clases/Calendario) -->
            <div class="tab-pane tab-pane-instant show active" id="tabClases" role="tabpanel" aria-labelledby="botonTabClases" tabindex="0">
                <h2 class="visually-hidden">Mis clases</h2>
                @if (errorBD)
                {
                    <div class="card estadoVacio"><p>No pudimos cargar tus clases. Probá de nuevo en unos minutos.</p></div>
                }
                else
                {
                    <div class="misClases" id="misClases" data-rol="@rolUsuario">
                        @* Las clases a las que les toca responder a esta persona, de todo el calendario *@
                        <section class="requiereAccion" id="clasesRequierenAccion" aria-labelledby="tituloRequiereAccion" hidden>
                            <h3 id="tituloRequiereAccion"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Clases que requieren tu acción <span class="badge theme-danger" id="cantidadRequiereAccion"></span></h3>
                            <ul id="listaRequiereAccion"></ul>
                        </section>

                        <div class="card calendarioMes">
                            <header>
                                <h3 id="tituloMes" aria-live="polite"></h3>
                                <div class="controlesMes">
                                    <button class="boton contorno chico" type="button" id="botonMesAnterior" aria-label="Mes anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                                    <button class="boton contorno chico" type="button" id="botonHoy">Hoy</button>
                                    <button class="boton contorno chico" type="button" id="botonMesSiguiente" aria-label="Mes siguiente"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                                </div>
                            </header>
                            <div class="diasSemana" aria-hidden="true">
                                <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
                            </div>
                            <div class="diasMes" id="diasMes" role="group" aria-labelledby="tituloMes">
                                <p class="cargandoHistorial"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tus clases…</p>
                            </div>
                            <ul class="leyenda" aria-label="Referencias del calendario">
                                <li><i class="linea azul" aria-hidden="true"></i> Está bien</li>
                                <li><i class="linea azul punteada" aria-hidden="true"></i> Esperando al otro</li>
                                <li><i class="linea rojo" aria-hidden="true"></i> Necesita tu acción</li>
                                <li><i class="linea gris" aria-hidden="true"></i> No se dio o se canceló</li>
                            </ul>
                        </div>

                        <div class="agendaDia" id="agendaDia" aria-live="polite"></div>
                    </div>
                }
            </div>

            @if (esProfesor)
            {
                <!-- Mi agenda: horario semanal y días bloqueados (miAgenda.js, con fetch a /Clases/MiAgenda) -->
                <div class="tab-pane tab-pane-instant" id="tabAgenda" role="tabpanel" aria-labelledby="botonTabAgenda" tabindex="0">
                    <h2 class="visually-hidden">Mi agenda</h2>
                    <p class="avisoSinAgenda" id="avisoSinAgendaPestana" hidden><i class="bi bi-info-circle" aria-hidden="true"></i> Todavía no configuraste tu agenda: los alumnos pueden pedirte clases de 8 a 22 cualquier día.</p>

                    <div class="row g-3 lg:g-4 miAgenda" id="miAgenda">
                        <div class="col-12 lg:col-7">
                            <div class="card">
                                <h3>Horario semanal</h3>
                                <p>Activá los días que das clases y elegí tus horarios. Cada clase dura 60 minutos.</p>
                                <ul class="diasDeAgenda" id="listaDiasAgenda" aria-live="polite">
                                    <li class="avisoChat"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tu agenda…</li>
                                </ul>
                                <p class="mensajeError" id="mensajeAgenda" role="alert"></p>
                                <button class="boton principal" type="button" id="botonGuardarAgenda"><i class="bi bi-check2" aria-hidden="true"></i> Guardar agenda</button>
                            </div>
                        </div>
                        <div class="col-12 lg:col-5">
                            <div class="card">
                                <h3>Días bloqueados</h3>
                                <p>Vacaciones, exámenes: nadie puede pedirte clases ese día.</p>
                                <form class="bloquearDia" id="formularioBloquearDia" novalidate>
                                    <div class="form-field">
                                        <label for="campoDiaBloqueado">Día a bloquear</label>
                                        <input class="form-control" type="date" id="campoDiaBloqueado" />
                                    </div>
                                    <button class="boton principal chico" type="submit"><i class="bi bi-slash-circle" aria-hidden="true"></i> Bloquear día</button>
                                </form>
                                <p class="mensajeError" id="mensajeBloqueo" role="alert"></p>
                                <ul class="listaBloqueados" id="listaDiasBloqueados" aria-live="polite"></ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Chat directo -->
            <div class="tab-pane tab-pane-instant" id="tabChat" role="tabpanel" aria-labelledby="botonTabChat" tabindex="0">
                <h2 class="visually-hidden">Chat directo</h2>
                @* Todo con fetch (chat.js → MensajesController): la lista de conversaciones, el chat abierto (al abrirlo,
                   los mensajes que te mandaron pasan a Visto) y el envío. Mientras la pestaña está a la vista se actualiza sola. *@
                <div class="card chat" id="chat">
                    <ul class="conversaciones" id="conversacionesChat" aria-label="Conversaciones">
                        <li class="avisoChat"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tus conversaciones…</li>
                    </ul>

                    <div class="hilo" id="hiloChat">
                        <header>
                            <span class="avatar theme-primary" id="avatarChat" aria-hidden="true"><i class="bi bi-chat-dots"></i></span>
                            <div>
                                <strong id="nombreChat">Elegí una conversación</strong>
                                <span id="detalleChat">Tus mensajes con profesores y alumnos aparecen acá.</span>
                            </div>
                        </header>
                        <div class="mensajes" id="mensajesChat" aria-live="polite"></div>
                        <form class="redactar" id="formularioChat" novalidate hidden>
                            <label for="campoMensajeChat" class="visually-hidden">Escribí tu mensaje</label>
                            <input class="form-control" type="text" id="campoMensajeChat" placeholder="Escribí un mensaje..." autocomplete="off" maxlength="1000" />
                            <button class="boton principal chico" type="submit" id="botonEnviarChat"><i class="bi bi-send" aria-hidden="true"></i> Enviar</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Historial de clases -->
            @* El historial propio se pide con fetch a /Historial/Obtener/{id} y lo dibuja historial.js (la misma tabla del modal de los perfiles) *@
            <div class="tab-pane tab-pane-instant" id="tabHistorial" role="tabpanel" aria-labelledby="botonTabHistorial" tabindex="0">
                <h2 class="visually-hidden">Historial de clases</h2>
                <div id="contenidoHistorialPanel" data-id-usuario="@Context.Session.GetString("idUsuario")">
                    <p class="cargandoHistorial"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tu historial…</p>
                </div>
            </div>
        </div>

        <p class="ayudaExtra">¿Necesitás ayuda con algo? <a asp-controller="Home" asp-action="Soporte">Ir a Soporte</a></p>
    </div>
</section>

<!-- ================= DIÁLOGO: CANCELAR CLASE (componente Dialog de Bootstrap 6) ================= -->
@* Lo abre calendario.js (data-accion-clase="cancelar") y escribe el texto según la clase: pedido sin aceptar, clase
   confirmada con 24 h o más (se cancela) o con menos (se le pide a la otra persona que lo confirme) *@
<dialog class="dialog" id="dialogoCancelarClase" aria-labelledby="tituloCancelarClase">
    <div class="dialog-header">
        <h2 class="dialog-title" id="tituloCancelarClase">¿Cancelar esta clase?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
    </div>
    <div class="dialog-body">
        <p id="textoCancelarClase"></p>
        <div class="form-field" id="campoMotivoCancelar">
            <label for="motivoCancelar">Motivo (opcional)</label>
            <textarea class="form-control" id="motivoCancelar" maxlength="500" rows="3" placeholder="Le llega por el chat a la otra persona"></textarea>
        </div>
        <p class="mensajeError" id="mensajeCancelarClase" role="alert"></p>
    </div>
    <div class="dialog-footer">
        <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Volver</button>
        <button type="button" class="boton oscuro chico" id="botonConfirmarCancelacion">Sí, cancelar</button>
    </div>
</dialog>

<!-- ================= DIÁLOGO: CAMBIAR HORARIO ================= -->
@* Cualquiera de los dos propone otro horario. Una clase pendiente vuelve a Pendiente; una confirmada sigue en su horario
   hasta que la otra persona acepte el nuevo *@
<dialog class="dialog dialogoClase" id="dialogoReubicarClase" aria-labelledby="tituloReubicarClase">
    <form id="formularioReubicarClase" onsubmit="return enviarReubicacionDeClase()" novalidate>
        <div class="dialog-header">
            <h2 class="dialog-title" id="tituloReubicarClase">Cambiar el horario</h2>
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
        </div>
        <div class="dialog-body">
            <p class="horarioActual"><i class="bi bi-clock" aria-hidden="true"></i> Horario actual: <strong id="horarioActualReubicar"></strong>, con <strong id="nombreClaseAReubicar"></strong>.</p>
            <p id="textoQuienResponde"></p>
            <partial name="_selectorHorario" model='"reubicar"' />
            <div class="form-field">
                <label for="motivoReubicar">Motivo (opcional)</label>
                <textarea class="form-control" id="motivoReubicar" maxlength="500" rows="2" placeholder="Le llega por el chat a la otra persona"></textarea>
            </div>
            <p class="mensajeError" id="mensajeReubicarClase" role="alert"></p>
        </div>
        <div class="dialog-footer">
            <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Volver</button>
            <button type="submit" class="boton principal chico" id="botonConfirmarReubicacion"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Proponer nuevo horario</button>
        </div>
    </form>
</dialog>

<!-- ================= DIÁLOGO: NO SE DIO ================= -->
@* Lo abren calendario.js y historial.js (data-no-se-dio): una clase completada de las últimas 48 h pasa a No concretada *@
<dialog class="dialog" id="dialogoNoSeDio" aria-labelledby="tituloNoSeDio">
    <div class="dialog-header">
        <h2 class="dialog-title" id="tituloNoSeDio">¿La clase no se dio?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
    </div>
    <div class="dialog-body">
        <p id="textoNoSeDio"></p>
        <p class="mensajeError" id="mensajeNoSeDio" role="alert"></p>
    </div>
    <div class="dialog-footer">
        <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Volver</button>
        <button type="button" class="boton oscuro chico" id="botonConfirmarNoSeDio">Sí, no se dio</button>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/historial.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script src="~/js/calendario.js" asp-append-version="true"></script>
    @if (esProfesor)
    {
        <script src="~/js/miAgenda.js" asp-append-version="true"></script>
    }
}
