@* Panel de Control. Las clases y las notificaciones vienen de la BD (HomeController.PanelControl);
   las acciones (aceptar, rechazar, reubicar, cancelar) se envían con fetch a ClasesController (clases.js)
   y el chat se pide y se envía con fetch a MensajesController (chat.js). *@
@{
    ViewData["Title"] = "Panel de Control";
    MisClases misClases = ViewBag.misClases ?? new MisClases();
    List<NotificacionUsuario> notificaciones = ViewBag.notificaciones ?? new List<NotificacionUsuario>();
    bool errorBD = ViewBag.errorBD ?? false;
    List<ClasePanel> clasesActivas = misClases.clases.Where(clase => clase.grupo != "historial").ToList();
    int mensajesSinLeer = notificaciones.Where(notificacion => notificacion.tipo == "mensajesSinLeer").Sum(notificacion => notificacion.cantidad);
    string nombreUsuario = ((Context.Session.GetString("nombre") ?? "") + " " + (Context.Session.GetString("apellido") ?? "")).Trim();
    string rolUsuario = Context.Session.GetString("tipoUsuario") == "profesor" ? "Profesor" : "Alumno";
}

@functions {
    // "lunes 19 de octubre" / "hace 5 min": formato argentino (la cultura es-AR se fija en Program.cs)
    static string textoDia(DateTime fecha)
    {
        string texto = fecha.ToString("dddd d 'de' MMMM");
        return char.ToUpper(texto[0]) + texto.Substring(1);
    }

    static string textoHorario(DateTime inicio, DateTime fin)
    {
        return inicio.ToString("HH:mm") + " a " + fin.ToString("HH:mm") + " hs";
    }

    static string tiempoRelativo(DateTime fecha)
    {
        TimeSpan pasado = DateTime.Now - fecha;
        if (pasado.TotalMinutes < 1) return "recién";
        if (pasado.TotalMinutes < 60) return "hace " + (int)pasado.TotalMinutes + " min";
        if (pasado.TotalHours < 24) return "hace " + (int)pasado.TotalHours + " h";
        if (pasado.TotalDays < 7) return "hace " + (int)pasado.TotalDays + (pasado.TotalDays < 2 ? " día" : " días");
        return fecha.ToString("dd/MM/yyyy");
    }

    static string iconoDeNotificacion(string tipo)
    {
        switch (tipo)
        {
            case "solicitudAmistad": return "bi-person-plus";
            case "mensajesSinLeer": return "bi-chat-dots";
            case "pedidoPorResponder": return "bi-calendar-plus";
            case "propuestaPorResponder": return "bi-arrow-repeat";
            default: return "bi-calendar-x";
        }
    }
}

<!-- ================= SALUDO ================= -->
<section class="saludo">
    <div class="container">
        <div class="d-flex flex-column sm:flex-row sm:align-items-center gap-3 sm:gap-4">
            <partial name="_avatarUsuario" model='"avatar-xl"' />
            <div>
                <span class="pildora">@rolUsuario</span>
                <h1>¡Hola, @nombreUsuario! 👋</h1>
                <p>Gestioná tus clases y tus mensajes.</p>
            </div>
        </div>
    </div>
</section>

@* Token para los fetch POST de las clases y del chat (clases.js y chat.js lo mandan en el encabezado) *@
@Html.AntiForgeryToken()

<!-- ================= NOTIFICACIONES ================= -->
<section class="notificaciones" id="notificaciones" aria-labelledby="tituloNotificaciones">
    <div class="container">
        <div class="card estatica">
            <h2 id="tituloNotificaciones">
                <i class="bi bi-bell" aria-hidden="true"></i> Notificaciones
                <span class="badge theme-primary" id="cantidadNotificacionesPanel" hidden="@(notificaciones.Count == 0)">@notificaciones.Count</span>
            </h2>

            @if (errorBD)
            {
                <p class="sinNotificaciones">No pudimos cargar tus notificaciones. Probá de nuevo en unos minutos.</p>
            }
            else if (notificaciones.Count == 0)
            {
                <p class="sinNotificaciones">No tenés nada pendiente. Acá vas a ver las solicitudes de amistad, los mensajes sin leer y las clases que esperan tu respuesta.</p>
            }
            else
            {
                @* Cada notificación es algo a medio resolver: desaparece sola cuando se resuelve (al abrir el chat, responder la clase, etc.) *@
                <ul class="listaNotificaciones">
                    @foreach (var notificacion in notificaciones)
                    {
                        bool esChat = notificacion.tipo == "mensajesSinLeer";
                        bool esAmistad = notificacion.tipo == "solicitudAmistad";
                        string urlDestino = notificacion.destino == "perfil"
                            ? Url.Action("Perfil", "Home", new { id = notificacion.idOtroUsuario })!
                            : esChat
                                ? Url.Action("PanelControl", "Home", new { tab = "chat", chat = notificacion.idOtroUsuario })!
                                : Url.Action("PanelControl", "Home", new { tab = "clases", clase = notificacion.idClase })!;
                        <li class="notificacion" data-tipo="@notificacion.tipo" data-id-otro="@notificacion.idOtroUsuario" data-nombre="@notificacion.nombreOtro">
                            <span class="icono @(esChat ? "celeste" : "")"><i class="bi @iconoDeNotificacion(notificacion.tipo)" aria-hidden="true"></i></span>
                            <div class="textoNotificacion">
                                <h3>
                                    @notificacion.titulo
                                    @if (esChat)
                                    {
                                        <span class="badge theme-primary">@(notificacion.cantidad == 1 ? "1 sin leer" : $"{notificacion.cantidad} sin leer")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-subtle theme-warning">Esperando tu respuesta</span>
                                    }
                                </h3>
                                <p>
                                    @notificacion.mensaje
                                    @if (esAmistad)
                                    {
                                        <a href="@urlDestino">Ver perfil</a>
                                    }
                                </p>
                                @if (notificacion.fecha != null)
                                {
                                    <small>@tiempoRelativo(notificacion.fecha.Value)</small>
                                }
                            </div>
                            @if (esAmistad)
                            {
                                @* La solicitud se responde acá mismo (clases.js → /Notificaciones/ResponderAmistad) *@
                                <div class="accionesNotificacion">
                                    <button class="boton contorno chico" type="button" data-responder-amistad="rechazar" aria-label="Rechazar la solicitud de @notificacion.nombreOtro @notificacion.apellidoOtro">Rechazar</button>
                                    <button class="boton principal chico" type="button" data-responder-amistad="aceptar" aria-label="Aceptar la solicitud de @notificacion.nombreOtro @notificacion.apellidoOtro"><i class="bi bi-check-lg" aria-hidden="true"></i> Aceptar</button>
                                </div>
                            }
                            else
                            {
                                <a class="boton principal chico" href="@urlDestino">@notificacion.textoBoton <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

<!-- ================= MÉTRICAS Y ACCESOS RÁPIDOS ================= -->
<section class="metricas">
    <div class="container">
        <div class="row g-3 lg:g-4">
            <div class="col-12 lg:col-4">
                <div class="row g-3 lg:g-4">
                    <div class="col-6 lg:col-12">
                        <div class="card">
                            <strong id="contadorClasesActivas">@(misClases.pendientes + misClases.proximas)</strong>
                            <span>Clases activas</span>
                        </div>
                    </div>
                    <div class="col-6 lg:col-12">
                        <div class="card oscura">
                            <strong id="contadorClasesCompletadas">@misClases.completadas</strong>
                            <span>Clases completadas</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 lg:col-8">
                <div class="row row-cols-2 g-3 lg:g-4 accesos">
                    <div class="col">
                        <a class="card" href="#panelTabs" data-abrir-tab="tabClases">
                            <span class="icono"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
                            <h3>Administrar clases</h3>
                            <p>Reubicá o cancelá tus clases.</p>
                        </a>
                    </div>
                    <div class="col">
                        <a class="card" href="#panelTabs" data-abrir-tab="tabChat">
                            <span class="icono oscuro"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                            <h3>Chat directo <span class="badge theme-primary" id="insigniaChat" hidden="@(mensajesSinLeer == 0)">@mensajesSinLeer</span></h3>
                            <p>@(rolUsuario == "Alumno" ? "Hablá con tus profesores." : "Hablá con tus alumnos.")</p>
                        </a>
                    </div>
                    <div class="col">
                        <a class="card" href="#panelTabs" data-abrir-tab="tabHistorial">
                            <span class="icono celeste"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                            <h3>Historial</h3>
                            <p>Mirá tus clases pasadas.</p>
                        </a>
                    </div>
                </div>

                <p class="ayudaExtra">
                    ¿Necesitás ayuda con algo? <a asp-controller="Home" asp-action="Soporte">Ir a Soporte <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ================= PANEL CON PESTAÑAS ================= -->
<section class="panel" id="panelTabs">
    <div class="container">
        <nav>
            <div class="nav nav-pills" role="tablist">
                <button class="nav-link active" id="botonTabClases" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabClases" aria-controls="tabClases" aria-selected="true"><i class="bi bi-calendar-check" aria-hidden="true"></i> Mis clases</button>
                <button class="nav-link" id="botonTabChat" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabChat" aria-controls="tabChat" aria-selected="false"><i class="bi bi-chat-dots" aria-hidden="true"></i> Chat directo</button>
                <button class="nav-link" id="botonTabHistorial" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabHistorial" aria-controls="tabHistorial" aria-selected="false"><i class="bi bi-clock-history" aria-hidden="true"></i> Historial</button>
            </div>
        </nav>

        <div class="tab-content">
            <!-- Mis clases programadas -->
            <div class="tab-pane show active" id="tabClases" role="tabpanel" aria-labelledby="botonTabClases" tabindex="0">
                <h2>Mis clases programadas</h2>
                @if (errorBD)
                {
                    <div class="card estatica estadoVacio"><p>No pudimos cargar tus clases. Probá de nuevo en unos minutos.</p></div>
                }
                else if (clasesActivas.Count == 0)
                {
                    <div class="card estatica estadoVacio">
                        <span class="icono"><i class="bi bi-calendar-plus" aria-hidden="true"></i></span>
                        <h3>Todavía no tenés clases programadas</h3>
                        <p>@(rolUsuario == "Alumno" ? "Buscá un profesor en el catálogo y enviale un pedido de clase." : "Cuando un alumno te pida una clase, la vas a ver acá para aceptarla o rechazarla.")</p>
                        @if (rolUsuario == "Alumno")
                        {
                            <a class="boton principal chico" asp-controller="Catalogo" asp-action="Index">Ir al catálogo</a>
                        }
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 lg:row-cols-2 g-3 lg:g-4">
                        @foreach (var clase in clasesActivas)
                        {
                            string nombreOtro = clase.nombreOtro + " " + clase.apellidoOtro;
                            <div class="col" id="clase-@clase.id">
                                <article class="card clase" data-clase data-id-clase="@clase.id" data-id-otro="@clase.idOtroUsuario"
                                         data-nombre-otro="@nombreOtro" data-fecha-texto="@textoDia(clase.fecha), @clase.fecha.ToString("HH:mm") hs"
                                         data-muy-cerca="@(clase.muyCerca ? "true" : "false")" data-estado="@clase.estado">
                                    <header>
                                        <span class="icono @(clase.estado == "Confirmada" ? "celeste" : "")"><i class="bi @(clase.estado == "Confirmada" ? "bi-calendar-check" : clase.estado == "Rechazada" ? "bi-calendar-x" : "bi-hourglass-split")" aria-hidden="true"></i></span>
                                        @if (clase.estado == "Confirmada")
                                        {
                                            <span class="badge badge-subtle theme-success">Confirmada</span>
                                        }
                                        else if (clase.estado == "Rechazada")
                                        {
                                            <span class="badge badge-subtle theme-danger">Horario rechazado</span>
                                        }
                                        else if (clase.esperaA == "yo")
                                        {
                                            <span class="badge theme-primary">Te toca responder</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-subtle theme-warning">Esperando respuesta</span>
                                        }
                                    </header>
                                    <h3>Clase con <a asp-controller="Home" asp-action="Perfil" asp-route-id="@clase.idOtroUsuario">@nombreOtro</a></h3>
                                    <p>@(clase.miRol == "alumno" ? "Profesor" : "Alumno")</p>
                                    <ul>
                                        <li><i class="bi bi-calendar-event" aria-hidden="true"></i> @textoDia(clase.fecha)</li>
                                        <li><i class="bi bi-clock" aria-hidden="true"></i> @textoHorario(clase.fecha, clase.fechaFin)</li>
                                        @if (clase.estado == "Pendiente" && clase.esperaA == "otro")
                                        {
                                            <li><i class="bi bi-hourglass-split" aria-hidden="true"></i> Esperando que responda @clase.nombreOtro</li>
                                        }
                                        @if (clase.estado == "Rechazada")
                                        {
                                            <li><i class="bi bi-info-circle" aria-hidden="true"></i> @(clase.esperaA == "yo" ? $"{clase.nombreOtro} no aceptó este horario: proponé otro o cancelá la clase." : $"Rechazaste este horario. Esperando que {clase.nombreOtro} proponga otro o cancele.")</li>
                                        }
                                        <li><i class="bi bi-person" aria-hidden="true"></i> <a asp-controller="Home" asp-action="Perfil" asp-route-id="@clase.idOtroUsuario">Ver perfil de @clase.nombreOtro</a></li>
                                    </ul>
                                    <footer>
                                        @if (clase.puedeResponder)
                                        {
                                            <button class="boton principal chico" type="button" data-accion-clase="aceptar"><i class="bi bi-check2" aria-hidden="true"></i> @(clase.miRol == "alumno" ? "Aceptar horario" : "Aceptar")</button>
                                            <button class="boton contorno chico" type="button" data-accion-clase="rechazar"><i class="bi bi-x-lg" aria-hidden="true"></i> Rechazar</button>
                                        }
                                        @if (clase.puedeReubicar)
                                        {
                                            @* Proponer otro horario cuando hay algo que responder o rechazado; cambiar el horario si está confirmada o esperando *@
                                            bool proponeOtro = clase.puedeResponder || clase.estado == "Rechazada";
                                            bool reubicarEsLoPrincipal = clase.estado == "Rechazada" && clase.esperaA == "yo";
                                            <button class="boton @(reubicarEsLoPrincipal ? "principal" : "contorno") chico" type="button" data-accion-clase="reubicar"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @(proponeOtro ? "Proponer otro horario" : "Cambiar horario")</button>
                                        }
                                        @if (clase.puedeCancelar)
                                        {
                                            <button class="boton oscuro chico" type="button" data-accion-clase="cancelar"><i class="bi bi-x-circle" aria-hidden="true"></i> @(clase.estado == "Pendiente" ? "Cancelar pedido" : "Cancelar clase")</button>
                                        }
                                    </footer>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Chat directo -->
            <div class="tab-pane" id="tabChat" role="tabpanel" aria-labelledby="botonTabChat" tabindex="0">
                <h2>Chat directo</h2>
                @* Todo con fetch (chat.js → MensajesController): la lista de conversaciones, el chat abierto (al abrirlo,
                   los mensajes que te mandaron pasan a Visto) y el envío. Mientras la pestaña está a la vista se actualiza sola. *@
                <div class="card estatica chat" id="chat">
                    <ul class="conversaciones" id="conversacionesChat" aria-label="Conversaciones">
                        <li class="avisoChat"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tus conversaciones…</li>
                    </ul>

                    <div class="hilo" id="hiloChat">
                        <header>
                            <span class="avatar theme-primary" id="avatarChat" aria-hidden="true"><i class="bi bi-chat-dots"></i></span>
                            <div>
                                <strong id="nombreChat">Elegí una conversación</strong>
                                <span id="detalleChat">Tus mensajes con profesores y alumnos aparecen acá.</span>
                            </div>
                        </header>
                        <div class="mensajes" id="mensajesChat" aria-live="polite"></div>
                        <form class="redactar" id="formularioChat" novalidate hidden>
                            <label for="campoMensajeChat" class="visually-hidden">Escribí tu mensaje</label>
                            <input class="form-control" type="text" id="campoMensajeChat" placeholder="Escribí un mensaje..." autocomplete="off" maxlength="1000" />
                            <button class="boton principal chico" type="submit" id="botonEnviarChat"><i class="bi bi-send" aria-hidden="true"></i> Enviar</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Historial de clases -->
            @* El historial propio se pide con fetch a /Historial/Obtener/{id} y lo dibuja historial.js (la misma tabla del modal de los perfiles) *@
            <div class="tab-pane" id="tabHistorial" role="tabpanel" aria-labelledby="botonTabHistorial" tabindex="0">
                <h2>Historial de clases</h2>
                <div id="contenidoHistorialPanel" data-id-usuario="@Context.Session.GetString("idUsuario")">
                    <p class="cargandoHistorial"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cargando tu historial…</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= DIÁLOGO: CANCELAR CLASE (componente Dialog de Bootstrap 6) ================= -->
@* Lo abre clases.js (data-accion-clase="cancelar") y escribe el texto según la clase: pedido sin aceptar o clase confirmada *@
<dialog class="dialog" id="dialogoCancelarClase" aria-labelledby="tituloCancelarClase">
    <div class="dialog-header">
        <h2 class="dialog-title" id="tituloCancelarClase">¿Cancelar esta clase?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
    </div>
    <div class="dialog-body">
        <p id="textoCancelarClase"></p>
        <p class="mensajeError" id="mensajeCancelarClase" role="alert"></p>
    </div>
    <div class="dialog-footer">
        <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Volver</button>
        <button type="button" class="boton principal chico" id="botonConfirmarCancelacion">Sí, cancelar</button>
    </div>
</dialog>

<!-- ================= DIÁLOGO: REUBICAR CLASE ================= -->
@* Cualquiera de los dos propone otro horario; la clase vuelve a Pendiente y le toca responder al otro *@
<dialog class="dialog dialogoClase" id="dialogoReubicarClase" aria-labelledby="tituloReubicarClase">
    <form id="formularioReubicarClase" onsubmit="return enviarReubicacionDeClase()" novalidate>
        <div class="dialog-header">
            <h2 class="dialog-title" id="tituloReubicarClase">Cambiar el horario</h2>
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
        </div>
        <div class="dialog-body">
            <p>Elegí el nuevo horario para tu clase con <strong id="nombreClaseAReubicar"></strong>. <strong id="nombreQuienResponde"></strong> tiene que confirmarlo.</p>
            <partial name="_selectorHorario" model='"reubicar"' />
            <p class="mensajeError" id="mensajeReubicarClase" role="alert"></p>
        </div>
        <div class="dialog-footer">
            <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Volver</button>
            <button type="submit" class="boton principal chico" id="botonConfirmarReubicacion"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Proponer nuevo horario</button>
        </div>
    </form>
</dialog>

<!-- ================= DIÁLOGO: LA CLASE EMPIEZA EN MENOS DE 24 H ================= -->
<dialog class="dialog" id="dialogoClaseCercana" aria-labelledby="tituloClaseCercana">
    <div class="dialog-header">
        <h2 class="dialog-title" id="tituloClaseCercana">La clase está muy próxima</h2>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Cerrar"></button>
    </div>
    <div class="dialog-body">
        <p>Tu clase con <strong id="nombreClaseCercana"></strong> empieza en menos de 24 horas, así que no se cancela ni se cambia sola. Coordinalo por el chat con esa persona.</p>
    </div>
    <div class="dialog-footer">
        <button type="button" class="boton contorno chico" data-bs-dismiss="dialog">Cerrar</button>
        <button type="button" class="boton principal chico" id="botonAbrirChatClaseCercana" data-bs-dismiss="dialog"><i class="bi bi-chat-dots" aria-hidden="true"></i> Ir al chat</button>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/historial.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
