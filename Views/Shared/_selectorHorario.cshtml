@* Selector de día y hora de inicio de una clase. Lo arma crearSelectorHorario() (site.js): al elegir el día
   trae las franjas ocupadas con fetch (/Clases/HorariosOcupados) y tacha las horas que no se pueden elegir.
   Modelo: prefijo para los id (el mismo selector se usa en "Pedir clase" y en "Reubicar"). *@
@model string
@{
    string prefijo = string.IsNullOrWhiteSpace(Model) ? "horario" : Model;
}

<div class="selectorHorario" data-selector-horario>
    <div class="form-field">
        <label for="@(prefijo)Dia">Día</label>
        <input class="form-control" type="date" id="@(prefijo)Dia" data-campo-dia
               min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(90).ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-field">
        <label id="@(prefijo)EtiquetaHora">Hora de inicio</label>
        <div class="franjas" data-franjas role="group" aria-labelledby="@(prefijo)EtiquetaHora" aria-live="polite">
            <p class="ayudaFranjas">Elegí primero un día.</p>
        </div>
        <small>Cada clase dura 60 minutos. Las horas tachadas ya están ocupadas.</small>
    </div>
</div>
