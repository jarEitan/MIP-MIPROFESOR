@* Tarjeta de profesor reutilizable (Inicio y Catálogo). Recibe un Profesor.
   El filtrado lo hace el SP obtenerCatalogo. *@
@model Profesor

<article class="card profesor">
    <header>
        @if (!string.IsNullOrEmpty(Model.fotoPerfil))
        {
            <span class="avatar"><img src="@Model.fotoPerfil" alt="Foto de perfil de @Model.nombreCompleto" /></span>
        }
        else
        {
            <span class="avatar theme-primary" aria-hidden="true">@Model.iniciales</span>
        }
        <div>
            <h3><a asp-controller="Home" asp-action="Perfil" asp-route-id="@Model.id">@Model.nombreCompleto</a></h3>
            <p><i class="bi bi-building" aria-hidden="true"></i> @(Model.colegios.Count == 0 ? "Sin colegio cargado" : string.Join(" · ", Model.colegios.Take(2)) + (Model.colegios.Count > 2 ? " +" + (Model.colegios.Count - 2) : ""))</p>
        </div>
        @if (Model.verificado)
        {
            <span class="badge badge-subtle theme-success" title="Credenciales revisadas por el equipo de MIP"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verificado</span>
        }
    </header>

    <div class="etiquetas">
        @for (int posicion = 0; posicion < Model.materias.Count && posicion < 3; posicion++)
        {
            <span class="badge @(posicion == 0 ? "theme-accent" : "badge-subtle theme-inverse")">@Model.materias[posicion]</span>
        }
        @if (Model.materias.Count > 3)
        {
            <span class="badge badge-subtle theme-inverse">+@(Model.materias.Count - 3)</span>
        }
    </div>

    @if (Model.resumen != "")
    {
        <p>@Model.resumen</p>
    }

    <ul class="datos">
        <li><i class="bi bi-star-fill" aria-hidden="true"></i> @(Model.cantidadResenas == 0 ? "Sin reseñas" : Model.calificacion.ToString("0.0")) @if (Model.cantidadResenas > 0) { <text>(@Model.cantidadResenas)</text> }</li>
        <li><i class="bi bi-laptop" aria-hidden="true"></i> @string.Join(" y ", Model.modalidades)</li>
        <li><i class="bi bi-mortarboard" aria-hidden="true"></i> @string.Join(", ", Model.niveles)</li>
    </ul>

    <footer>
        <p><strong>$ @Model.precioHora.ToString("N0")</strong> <span>/ hora</span></p>
        <a class="boton principal chico" asp-controller="Home" asp-action="Perfil" asp-route-id="@Model.id">Ver perfil</a>
    </footer>
</article>
