<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MiProfesor (MIP): una plataforma donde cada docente puede compartir su conocimiento y cada alumno encontrar la ayuda que necesita." />
    <meta name="theme-color" content="#FF5757" />
    <title>@ViewData["Title"] | MiProfesor (MIP)</title>

    @* Open Graph: vista previa al compartir el link *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MiProfesor (MIP)" />
    <meta property="og:title" content="@ViewData["Title"] | MiProfesor (MIP)" />
    <meta property="og:description" content="Encontrá al profesor ideal para tu colegio." />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/logoChico.png")" />

    <link rel="icon" type="image/png" href="~/img/logoChico.png" />
    <link rel="preload" href="~/fonts/plusJakartaSansLatin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.add("jsActivo");</script>
</head>
<body>
    <!-- ================= HEADER ================= -->
    @* Sin sesión → navegación de invitado. Cuando exista el login, guardar "idUsuario" en Session. *@
    @if (Context.Session.GetString("idUsuario") == null)
    {
        <partial name="_encabezadoInvitado" />
    }
    else
    {
        <partial name="_encabezadoUsuario" />
    }

    <!-- ================= MAIN ================= -->
    <main role="main" class="contenidoPrincipal">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <partial name="_piePagina" />

    @* jQuery no se usa. Si una vista necesita _ValidationScriptsPartial, agregar jQuery en su sección Scripts. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
